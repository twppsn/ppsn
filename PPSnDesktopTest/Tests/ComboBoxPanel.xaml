<UserControl x:Class="TecWare.PPSn.Tests.ComboBoxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TecWare.PPSn.Tests"
			 xmlns:ui="http://tecware-gmbh.de/ppsn/wpf/2015"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
		<Grid Margin="20">
			<ui:PpsComboBox x:Name="testBox" Width="100">
				<ui:PpsComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" />
					</DataTemplate>
				</ui:PpsComboBox.ItemTemplate>
			</ui:PpsComboBox>
		</Grid>
    </StackPanel>
</UserControl>
